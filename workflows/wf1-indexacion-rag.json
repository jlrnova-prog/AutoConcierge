    {
      "parameters": {
        "jsCode": "// Fragmenta el texto y antepone a cada fragmento el título del documento.\n// Motivo: en las fichas técnicas muchos fragmentos son filas de tabla que no nombran el modelo;\n// sin el encabezado, «potencia del Sportage» no encontraba la ficha del Sportage (evaluación v1).\n// 'search_document:' es el prefijo que recomienda nomic-embed-text para los documentos.\nconst f = $('Loop archivos').first().json;\nconst texto = String($input.first().json.text || '')\n  .replace(/\\r/g, '').replace(/[ \\t]+/g, ' ').replace(/\\n{3,}/g, '\\n\\n').trim();\nconst titulo = f.archivo.replace(/\\.pdf$/i, '').replace(/^Ficha_Tecnica_/i, 'Ficha técnica Kia ').replace(/_/g, ' ');\nif (texto.length < 50) return [{ json: { ...f, sin_texto: true } }];\n\nconst TAM = 900, SOLAPE = 150;\nconst partes = [];\nlet i = 0;\nwhile (i < texto.length) {\n  let fin = Math.min(i + TAM, texto.length);\n  if (fin < texto.length) {\n    const corte = texto.lastIndexOf('\\n', fin);\n    if (corte > i + TAM * 0.5) fin = corte; // corta en un salto de línea si puede\n  }\n  partes.push(texto.slice(i, fin).trim());\n  if (fin >= texto.length) break;\n  i = fin - SOLAPE;\n}\nreturn partes.filter(Boolean).map((p, n) => ({ json: {\n  ...f, sin_texto: false, titulo, fragmento: n + 1,\n  texto: `search_document: [${titulo}] ${p}`,\n} }));"
      },
